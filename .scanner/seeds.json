          "NVlabs/ASPIRE",
          "Physical-Intelligence/openpi",
          "NVIDIA/Isaac-GR00T",
          "allenai/vla-evaluation-harness",
          "XPolicyLab/XPolicyLab",
          "isaac-sim/IsaacLab",
          "google-deepmind/mujoco",
          "newton-physics/newton",
          "Genesis-Embodied-AI/genesis-world",
          "StanfordVL/BEHAVIOR-1K"
        ],
        "note": "a release is a candidate only if it changes what the list says (new capability, licence change, archive)"
      }
