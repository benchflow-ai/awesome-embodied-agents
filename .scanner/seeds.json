        "id": "open-web-launches",
        "recall_critical": true,
        "queries": [
          "\"agent as a policy\" robot",
          "\"robot-use agent\"",
          "\"world action model\" API",
          "coding agent controls robot benchmark",
          "robot policy leaderboard launch",
