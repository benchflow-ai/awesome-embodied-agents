    "arxiv": [
      {
        "id": "arxiv-cs-ro",
        "feed_url": "https://rss.arxiv.org/rss/cs.RO",
        "index_url": "https://arxiv.org/list/cs.RO/new",
        "filter": "title screen: agents and coding agents controlling robots, LLM or VLM as policy, world-action models, benchmarks, leaderboards, robot safety, simulators, datasets"
      },
      {
        "id": "arxiv-agents-query",
        "feed_url": "https://export.arxiv.org/api/query?search_query=cat:cs.RO+AND+(abs:%22coding+agent%22+OR+abs:%22LLM+agent%22+OR+abs:%22agent+as+policy%22+OR+abs:%22world+action+model%22+OR+abs:benchmark)&sortBy=submittedDate&sortOrder=descending&max_results=40",
        "index_url": null,
        "note": "wait 3 seconds between arXiv API calls"
      }
    ],
    "hf": [
      {
        "id": "hf-papers",
        "feed_url": null,
        "index_url": "https://huggingface.co/papers",
        "filter": "robotics and embodied only"
      },
      {
        "id": "hf-robotics-models",
        "feed_url": "https://huggingface.co/api/models?pipeline_tag=robotics&sort=trendingScore&direction=-1&limit=50",
        "index_url": "https://huggingface.co/models?pipeline_tag=robotics&sort=trending",
        "filter": "new base models from labs; skip personal fine-tune checkpoints"
      }
    ],
    "github": [
      {
        "id": "gh-robot-agents",
        "gh_api": "search/repositories",
        "q": "topic:robotics (agent OR mcp OR llm OR vla OR \"world model\") created:>={FLOOR}",
        "sort": "stars"
      },
      {
        "id": "gh-embodied-ai",
        "gh_api": "search/repositories",
        "q": "topic:embodied-ai created:>={FLOOR}",
        "sort": "stars"
      },
      {
        "id": "gh-robot-mcp",
        "gh_api": "search/repositories",
        "q": "topic:mcp (robot OR ros OR ros2 OR drone) created:>={FLOOR}",
        "sort": "stars"
      },
      {
        "id": "gh-watched-releases",
        "gh_api": "repos/<repo>/releases?per_page=5",
        "repos": [
          "dimensionalOS/dimos",
          "stacx-lab/kinex",
          "robocurve/inspect-robots",
          "huggingface/lerobot",
          "capgym/cap-x",
